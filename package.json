{
  "name": "passport-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-data.mjs && vite",
    "build": "node scripts/ensure-data.mjs && tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "check": "node scripts/check-data.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "tsc -b --noEmit && node scripts/check-data.mjs && node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "bench": "node scripts/bench.mjs",
    "frames": "node scripts/frames.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
